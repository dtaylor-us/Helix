# Copy this file to .env and replace placeholder values.
# scripts/dev-api and scripts/dev-web automatically load .env from repo root.

# Database
HELIX_DB_URL=jdbc:postgresql://localhost:5432/helix
HELIX_DB_USER=helix
HELIX_DB_PASSWORD=helix

# Optional API port override
PORT=8080

# AI provider config
HELIX_AI_PROVIDER=openai
OPENAI_API_KEY=replace-with-your-openai-api-key

# Optional web override if API runs on a custom port
# VITE_API_BASE_URL=http://localhost:8080
