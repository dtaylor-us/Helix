#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ -f "$ROOT_DIR/.env" ]]; then
	# Load .env keys only when not already set in the current environment.
	while IFS= read -r line || [[ -n "$line" ]]; do
		[[ -z "$line" || "$line" == \#* || "$line" != *=* ]] && continue

		key="${line%%=*}"
		value="${line#*=}"

		if [[ ! "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
			continue
		fi

		if [[ -z "${!key+x}" ]]; then
			export "$key=$value"
		fi
	done < "$ROOT_DIR/.env"
fi

cd "$ROOT_DIR/apps/api"
./gradlew bootRun
