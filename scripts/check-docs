#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

for f in $(find docs -type f -name '*.md'); do
  if grep -q '```mermaid' "$f"; then
    open_count=$(grep -c '```mermaid' "$f")
    close_count=$(grep -c '^```$' "$f")
    if [[ "$close_count" -lt "$open_count" ]]; then
      echo "Unbalanced mermaid fence in $f"
      exit 1
    fi
  fi
done

echo "Docs check complete."
